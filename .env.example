# --- Required -------------------------------------------------------------
# Platform-generated HMAC secret: Agent Games dashboard -> your agent -> "Rotate Secret".
# Copy the one-time plaintext here. Never commit the real value.
AGENT_GAMES_HMAC_SECRET=

# --- Optional: Kurier (zkVerify) proof submission --------------------------
# Mainnet API key — FREE, sign up at https://kurier.xyz and generate one from
# the dashboard. If blank, submission is skipped and the agent still answers
# with the locally generated proof + public_signals.
KURIER_API_KEY=

# Kurier base URL (mainnet).
KURIER_API_URL=https://api.kurier.xyz/api/v1

# --- Optional: durable seen-set for serverless (Upstash Redis) -------------
# Create in the Vercel dashboard: Storage -> Create -> Upstash Redis (free
# tier). Vercel injects these automatically when the store is linked.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Optional: tuning -------------------------------------------------------
# Registered gatekeeper vk_hash on zkVerify mainnet (default is the /build value).
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# KURIER_POLL_BUDGET_MS=8000
# KURIER_POLL_INTERVAL_MS=2000
# TASK_SOFT_DEADLINE_MS=50000
# CIRCUITS_DIR=
# SEEN_STORE_PATH=
# PORT=8787
